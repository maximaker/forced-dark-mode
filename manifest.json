{
  "manifest_version": 3,
  "name": "Forced Dark Mode",
  "version": "1.3.3",
  "description": "Turn on a dark mode for any site that doesn't have one. Warmer at night, switches at sunset.",
  "permissions": ["storage", "activeTab", "geolocation", "contextMenus", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Forced Dark Mode",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle dark mode on this site"
    }
  },
  "background": { "service_worker": "background.js" }
}
